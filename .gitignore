# --------------------------------------------------------------------------
# TerraAlert – project-wide .gitignore
# --------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
*.so

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store

# Large data (never commit raw satellite tiles or full outputs)
data/raw/
data/gee_cache/
data/previews/
cache/
outputs/*.tif
outputs/*.geojson
outputs/overlays/
outputs/report.pdf

# Keep demo outputs committed
!outputs/demo/

# Earth Engine credentials (safety)
.config/earthengine/

# Pytest / coverage
.pytest_cache/
htmlcov/
.coverage
*.cover

# Logs
*.log

# ML model weight cache (large files, downloaded on demand via huggingface_hub)
data/models/
